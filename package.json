{
  "name": "dsh-lakemind",
  "version": "0.1.2",
  "description": "涟漪记忆湖：把 meow-memory 画成同心水波，按重要性与时间分层淡化，并把记忆长进人格里。DeepSeek Harness 插件。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "test": "node test/lake-core-test.mjs && node test/host-endpoint-test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "memory-visualization",
    "persona",
    "meow-memory"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ZJW-big/dsh-lakemind.git"
  },
  "homepage": "https://github.com/ZJW-big/dsh-lakemind#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lake-core.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "persona.seed.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  }
}
